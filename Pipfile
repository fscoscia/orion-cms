[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
orion = {path = ".", editable = true, extras = ["postgres", "mysql"]}
# WhiteNoise's Brotli; pinned because the newest release is days old.
brotli = "==1.2.0"
# Pulled in by Django; pinned because the newest release is days old.
sqlparse = "==0.6.0"

[dev-packages]
pytest = "~=9.2"
pytest-django = "~=4.14"
pytest-playwright = "~=0.10.0"
ruff = "~=0.17.3"
pre-commit = "~=4.7"
django-tailwind-cli = "==4.8.1"
# Pulled in by pre-commit; pinned because newer releases are days old.
python-discovery = "==1.6.3"
filelock = "==4.2.0"
nodeenv = "==1.11.0"
platformdirs = "==4.13.3"

[requires]
python_version = "3.12"

[scripts]
test = "pytest"
test-postgres = "sh -c 'DATABASE_URL=${POSTGRES_TEST_URL:-postgres:///orion} pytest'"
test-mysql = "sh -c 'DATABASE_URL=${MYSQL_TEST_URL:-mysql://orion:orion@127.0.0.1:3306/orion} pytest'"
test-e2e-postgres = "sh -c 'DATABASE_URL=${POSTGRES_TEST_URL:-postgres:///orion} DJANGO_ALLOW_ASYNC_UNSAFE=1 pytest -m e2e'"
test-e2e-mysql = "sh -c 'DATABASE_URL=${MYSQL_TEST_URL:-mysql://orion:orion@127.0.0.1:3306/orion} DJANGO_ALLOW_ASYNC_UNSAFE=1 pytest -m e2e'"
lint = "ruff check ."
format = "ruff format ."
manage = "python example/manage.py"
css-build = "python example/manage.py tailwind build"
css-watch = "python example/manage.py tailwind watch"
