# Copy this file to .env for local development. Never commit .env: it holds secrets.
#
# `pipenv run` loads .env and its values OVERRIDE variables set in the shell, so
# `DEBUG=false pipenv run ...` keeps the DEBUG from .env. Change values here, or run
# once without .env: `PIPENV_DONT_LOAD_ENV=1 DEBUG=false pipenv run ...`.

# Core
DEBUG=true
# Required when DEBUG is false. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database: PostgreSQL (recommended) or MySQL
DATABASE_URL=postgres:///orion
# DATABASE_URL=mysql://orion:orion@127.0.0.1:3306/orion
# Seconds a database connection is reused (0 closes it after each request)
DATABASE_CONN_MAX_AGE=60
# Databases used by `pipenv run test-postgres` and `pipenv run test-mysql`
POSTGRES_TEST_URL=postgres:///orion
MYSQL_TEST_URL=mysql://orion:orion@127.0.0.1:3306/orion

# Cache: empty uses files in the system's temporary folder. Also file:///path,
# redis://127.0.0.1:6379/1 (needs orion[redis]), locmem:// or dummy://
CACHE_URL=
# Full-page cache for visitors without a session; on by default when DEBUG is off
ORION_PAGE_CACHE=
# With the containers from docker-compose.yml, use these instead:
# POSTGRES_TEST_URL=postgres://orion:orion@127.0.0.1:5433/orion
# MYSQL_TEST_URL=mysql://orion:orion@127.0.0.1:3307/orion

# Site
LANGUAGE_CODE=es
TIME_ZONE=UTC
WAGTAIL_SITE_NAME=Orion
WAGTAILADMIN_BASE_URL=http://localhost:8000
# Admin URL path: no leading slash, trailing slash required
ORION_ADMIN_PATH=admin/
# Second factor for every admin user. Set to false only for local development.
ORION_2FA_REQUIRED=true
# Wrong passwords for one user from one address before locking it out, and for how
# many minutes (unlock earlier with `manage.py axes_reset_username <user>`)
ORION_LOGIN_FAILURE_LIMIT=5
ORION_LOGIN_LOCKOUT_MINUTES=15
# Proxies of your own in front of the site: 1 behind Nginx, 0 on cPanel or exposed
# directly. A higher number lets visitors choose the address they are seen with.
ORION_TRUSTED_PROXIES=0
# HTTPS: redirect HTTP outside debug, and how long browsers remember to use HTTPS
# (one year outside debug; the site cannot go back to HTTP before it ends)
ORION_SSL_REDIRECT=
ORION_HSTS_SECONDS=
ORION_HSTS_INCLUDE_SUBDOMAINS=false
ORION_HSTS_PRELOAD=false
# Content security policy of the public site in report-only mode: blocks nothing
ORION_CSP_REPORT_ONLY=false

# Email (SMTP). Use either SSL (usually port 465) or TLS (usually port 587), not both.
# TLS is on unless EMAIL_USE_SSL is true; set EMAIL_USE_TLS=false only for servers
# without STARTTLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost

# Largest image the admin accepts, in MB.
ORION_IMAGE_MAX_UPLOAD_MB=10
# Document extensions accepted (empty: PDF, Office, OpenDocument, TXT and CSV) and the
# largest document, in MB
ORION_DOCUMENT_EXTENSIONS=
ORION_DOCUMENT_MAX_UPLOAD_MB=20

# Folder for form attachments, outside MEDIA_ROOT; empty means "private" next to it.
ORION_FORMS_PRIVATE_ROOT=
# Months form submissions are kept (orion_purge_submissions); 0 keeps them
ORION_FORMS_RETENTION_MONTHS=12
# Days during which email notices that failed are sent again (orion_retry_form_emails)
ORION_FORMS_EMAIL_RETRY_DAYS=3

# PostgreSQL text search configuration; empty uses the base language's (spanish)
ORION_SEARCH_CONFIG=

# Emergency switch: true stops loading every code snippet pasted in the admin
ORION_SCRIPTS_DISABLED=false
