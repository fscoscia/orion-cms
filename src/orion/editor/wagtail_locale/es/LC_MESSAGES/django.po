msgid "Add locale"
msgstr "Agregar región"

#: wagtail_localize
msgid "Apply machine translations to the incoming changes."
msgstr "Aplicar traducción automática a los cambios que llegan."

#: wagtail_localize
msgid "Apply the updates and publish immediately. The changes will use the original language until translated unless you also select \"Use machine translation\"."
msgstr "Aplicar los cambios y publicar ya. Los cambios quedarán en el idioma original hasta que se traduzcan, salvo que también se elija \"Usar traducción automática\"."

#: wagtail_localize
msgid "Apply the updates and publish immediately. The changes will use the original language until translated."
msgstr "Aplicar los cambios y publicar ya. Los cambios quedarán en el idioma original hasta que se traduzcan."

#: wagtail_localize
msgid "Are you sure you want to delete this locale?"
msgstr "¿Borrar esta región?"

#: wagtail_localize
msgid "Delete locale"
msgstr "Borrar la región"

#: wagtail_localize
msgid "Locale '{0}' created."
msgstr "Región '{0}' creada."

#: wagtail_localize
msgid "Locale '{0}' deleted."
msgstr "Región '{0}' borrada."

#: wagtail_localize
msgid "Locale '{0}' updated."
msgstr "Región '{0}' actualizada."

#: wagtail_localize
msgid "Select a new language"
msgstr "Elegir un idioma nuevo"

#: wagtail_localize
msgid "The locale could not be saved due to errors."
msgstr "No se pudo guardar la región por errores."

#: wagtail_localize
msgid "This locale cannot be deleted because there are pages and/or other objects using it."
msgstr "Esta región no se puede borrar porque hay páginas u otros objetos que la usan."

#: wagtail_localize
msgid "This locale's current language code is not supported. Please choose a new language or delete this locale."
msgstr "El código de idioma actual de esta región no está admitido. Elegir un idioma nuevo o borrar la región."

