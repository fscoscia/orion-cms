msgstr[2] "+ %(counter)s objetos más"

#: two_factor.py:34
msgid "Code"
msgstr "Código"

#: two_factor.py:86
msgid ""
"The code is not valid or has expired. After several wrong codes, wait a "
"moment before trying again."
msgstr ""
"El código no es válido o venció. Después de varios códigos incorrectos, "
"esperar un momento antes de volver a intentar."

#: two_factor.py:119
msgid "The code is not valid. Check the time on the phone."
msgstr "El código no es válido. Revisar que la hora del teléfono sea correcta."

#: two_factor.py:123
msgid "QR code for the authenticator app"
msgstr "Código QR para la app autenticadora"

#: two_factor.py:193
#, python-format
msgid "%(user)s will set up the two-factor authentication again at next login."
msgstr ""
"%(user)s volverá a configurar la verificación en dos pasos en su próximo "
"ingreso."

