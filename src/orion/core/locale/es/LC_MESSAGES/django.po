#: blocks/content.py:441
msgid "Figure"
msgstr "Cifra"

#: blocks/content.py:449 blocks/content.py:453
msgid "Figures"
msgstr "Cifras"

#: blocks/content.py:454
msgid "Large numbers that count up when they appear on screen."
msgstr "Números grandes que se cuentan al aparecer en pantalla."

#: blocks/content.py:474
msgid "Tab"
msgstr "Pestaña"

#: blocks/content.py:478 blocks/content.py:483
msgid "Question"
msgstr "Pregunta"

#: blocks/content.py:479
msgid "Answer"
msgstr "Respuesta"

#: blocks/content.py:498 blocks/content.py:506
msgid "Tabs"
msgstr "Pestañas"

#: blocks/content.py:507
msgid "Content split into tabs; only one tab is shown at a time."
msgstr "Contenido dividido en pestañas; se muestra una pestaña a la vez."

#: blocks/content.py:522
msgid "Questions"
msgstr "Preguntas"

#: blocks/content.py:526
msgid "Accordion"
msgstr "Acordeón"

#: blocks/content.py:527
msgid "Questions that open to show their answer, such as an FAQ."
msgstr ""
"Preguntas que se abren para mostrar su respuesta, como unas preguntas "
"frecuentes."

#: blocks/content.py:548
msgid "Call to action"
msgstr "Llamada a la acción"

#: blocks/content.py:550
msgid "A highlighted box that invites visitors to take the next step."
msgstr "Un recuadro destacado que invita a dar el siguiente paso."

#: blocks/content.py:561 blocks/content.py:571
msgid "Logo"
msgstr "Logo"

#: blocks/content.py:563 blocks/content.py:817
msgid "Name"
msgstr "Nombre"

#: blocks/content.py:565
msgid "Read by screen readers and shown if the image fails to load."
msgstr "Lo leen los lectores de pantalla y se muestra si la imagen no carga."

#: blocks/content.py:567
msgid "Website"
msgstr "Sitio web"

#: blocks/content.py:579 blocks/content.py:589
msgid "Logos"
msgstr "Logos"

#: blocks/content.py:591
msgid "A row of logos, such as partners or clients, with optional links."
msgstr "Una fila de logos, como convenios o clientes, con enlaces opcionales."

#: blocks/content.py:607
msgid "Label"
msgstr "Etiqueta"

#: blocks/content.py:607
msgid "Opening hours"
msgstr "Horario"

#: blocks/content.py:613
msgid "Extra item"
msgstr "Dato extra"

#: blocks/content.py:621 blocks/links.py:135
#: templates/orion/includes/contact_details.html:8
msgid "Phone"
msgstr "Teléfono"

#: blocks/content.py:623
msgid "WhatsApp"
msgstr "WhatsApp"

#: blocks/content.py:625 blocks/links.py:134
#: templates/orion/includes/contact_details.html:8
msgid "Email"
msgstr "Email"

#: blocks/content.py:626 templates/orion/includes/contact_details.html:8
msgid "Address"
msgstr "Dirección"

#: blocks/content.py:628
msgid "Extra items"
msgstr "Datos extra"

#: blocks/content.py:643
msgid "Contact details"
msgstr "Datos de contacto"

#: blocks/content.py:645
msgid ""
"The site's phone, WhatsApp, email and address from Site data, plus extra "
"items such as opening hours."
msgstr ""
"El teléfono, el WhatsApp, el email y la dirección de Datos del sitio, más "
"datos extra como el horario."

#: blocks/content.py:662
msgid "Alignment"
msgstr "Alineación"

#: blocks/content.py:663
msgid "Center"
msgstr "Centro"

#: blocks/content.py:670
msgid "One to three buttons in a row."
msgstr "De uno a tres botones en fila."

#: blocks/content.py:707
msgid "How many"
msgstr "Cantidad"

#: blocks/content.py:711
msgid "Listing"
msgstr "Listado"

#: blocks/content.py:713
msgid "Optional. Without a listing, shows articles from all of them."
msgstr "Opcional. Sin un listado, muestra artículos de todos."

#: blocks/content.py:742
msgid "Latest articles"
msgstr "Últimas novedades"

#: blocks/content.py:743
msgid "The most recent articles, from every listing or from one."
msgstr "Los artículos más recientes, de todos los listados o de uno."

#: blocks/content.py:754 blocks/content.py:785
msgid "Form"
msgstr "Formulario"

#: blocks/content.py:755
msgid "Submissions arrive at the form's page, as if sent from there."
msgstr ""
"Los envíos llegan a la página del formulario, como si se enviaran desde ahí."

#: blocks/content.py:786
msgid "A form created in Pages, to fill in from this page."
msgstr "Un formulario creado en Páginas, para completarlo desde esta página."

#: blocks/content.py:816
msgid "Location"
msgstr "Ubicación"

#: blocks/content.py:819
msgid "Description"
msgstr "Descripción"

#: blocks/content.py:822
msgid "For example, the address or the opening hours."
msgstr "Por ejemplo, la dirección o el horario."

#: blocks/content.py:827
msgid "Point"
msgstr "Punto"

#: blocks/content.py:836
msgid "Include the site location"
msgstr "Incluir la ubicación del sitio"

#: blocks/content.py:839
msgid "The location set in Site data."
msgstr "La ubicación cargada en Datos del sitio."

#: blocks/content.py:841
msgid "Points"
msgstr "Puntos"

#: blocks/content.py:843
msgid "Zoom"
msgstr "Zoom"

#: blocks/content.py:847
msgid "Used with a single point; several points are all shown."
msgstr "Se usa con un solo punto; con varios, se muestran todos."

#: blocks/content.py:881 templates/orion/includes/map.html:11
msgid "Map"
msgstr "Mapa"

#: blocks/content.py:883
msgid ""
"A map with the site location and other points, loaded when the visitor asks "
"for it."
msgstr ""
"Un mapa con la ubicación del sitio y otros puntos, que se carga cuando el "
"visitante lo pide."

#: blocks/content.py:905
msgid "Choose an MP4 or WebM video."
msgstr "Elegir un video MP4 o WebM."

#: blocks/content.py:915 blocks/content.py:947 blocks/content.py:956
msgid "Video"
msgstr "Video"

#: blocks/content.py:917
msgid "An MP4 or WebM from the document library, in a public collection."
msgstr ""
"Un MP4 o WebM de la biblioteca de documentos, en una colección pública."

#: blocks/content.py:921
msgid "Cover image"
msgstr "Imagen de portada"

#: blocks/content.py:922
msgid "Shown until the video plays."
msgstr "Se muestra hasta que el video se reproduce."

#: blocks/content.py:925
msgid "Playback"
msgstr "Reproducción"

#: blocks/content.py:927
msgid "With controls: the visitor starts it, with sound"
msgstr "Con controles: lo inicia el visitante, con sonido"

#: blocks/content.py:928
msgid "Ambient: muted and looping while on screen"
msgstr "Ambiente: sin sonido y en bucle mientras está en pantalla"

#: blocks/content.py:933
msgid "Format"
msgstr "Formato"

#: blocks/content.py:935
msgid "Landscape (16:9)"
msgstr "Horizontal (16:9)"

#: blocks/content.py:936
msgid "Vertical (9:16)"
msgstr "Vertical (9:16)"

#: blocks/content.py:948
msgid "A video from the library, with a cover image."
msgstr "Un video de la biblioteca, con imagen de portada."

#: blocks/content.py:958
msgid "Optional. Plays muted and looping; the image is its cover."
msgstr "Opcional. Se reproduce sin sonido y en bucle; la imagen es su portada."

#: blocks/content.py:970
msgid "Slide"
msgstr "Diapositiva"

#: blocks/content.py:979
msgid "Arrangement"
msgstr "Disposición"

#: blocks/content.py:981
msgid "One slide across the full width"
msgstr "Una diapositiva a todo el ancho"

#: blocks/content.py:982
msgid "Several cards at a time"
msgstr "Varias tarjetas a la vez"

#: blocks/content.py:987 templates/orion/blocks/carousel.html:3
#: templates/orion/blocks/carousel.html:5
msgid "Slides"
msgstr "Diapositivas"

#: blocks/content.py:998
msgid "Carousel"
msgstr "Carrusel"

#: blocks/content.py:1000
msgid "Slides that the visitor moves through, one or several at a time."
msgstr "Diapositivas que el visitante recorre, de a una o de a varias."

#: blocks/content.py:1044
msgid "The hero must be the first block."
msgstr "El Hero tiene que ser el primer bloque."

#: blocks/content.py:1056
msgid "This anchor is reserved by the site. Choose another one."
msgstr "El sitio usa esta ancla. Elegir otra."

#: blocks/content.py:1060
msgid "Another block of this page already uses this anchor."
msgstr "Otro bloque de esta página ya usa esta ancla."

#: blocks/links.py:42
msgid "Use only lowercase letters, numbers and hyphens, without # or spaces."
msgstr "Usar solo minúsculas, números y guiones, sin # ni espacios."

#: blocks/links.py:126
msgid "Leave empty to use the page title, email or phone."
msgstr "Dejar vacío para usar el título de la página, el email o el teléfono."

#: blocks/links.py:128
msgid "Page"
msgstr "Página"

#: blocks/links.py:130
msgid "Section of the page"
msgstr "Sección de la página"

#: blocks/links.py:131
msgid "Optional. The anchor of a block of the chosen page."
msgstr "Opcional. El ancla de un bloque de la página elegida."

#: blocks/links.py:133
msgid "External URL"
msgstr "URL externa"

#: blocks/links.py:137
msgid "Open in a new tab"
msgstr "Abrir en una pestaña nueva"

#: blocks/links.py:139
msgid "Only applies to external URLs."
msgstr "Solo se aplica a URLs externas."

#: blocks/links.py:156
msgid "Choose only one destination: a page, a URL, an email or a phone."
msgstr "Elegir un solo destino: una página, una URL, un email o un teléfono."

#: blocks/links.py:166
msgid "Choose a destination: a page, a URL, an email or a phone."
msgstr "Elegir un destino: una página, una URL, un email o un teléfono."

#: blocks/links.py:173
msgid "Choose the page that has this section."
msgstr "Elegir la página que tiene esta sección."

#: blocks/links.py:179
msgid "This address belongs to this site. Choose the page instead."
msgstr "Esta dirección es de este sitio. Conviene elegir la página."

#: blocks/links.py:183
msgid "Enter a phone number using digits, spaces, '+', '-' or parentheses."
msgstr "Ingresar un teléfono con dígitos, espacios, '+', '-' o paréntesis."

#: document_forms.py:32
#, python-format
msgid "The file is too large. The maximum is %(size)s."
msgstr "El archivo es demasiado grande. El máximo es %(size)s."

#: document_forms.py:38
#, python-format
msgid "The file's content does not match its type (%(extension)s)."
msgstr "El contenido del archivo no corresponde a su tipo (%(extension)s)."

#: forms.py:26
msgid "Choose a location on the map."
msgstr "Elegir una ubicación en el mapa."

#: forms.py:29
msgid "The latitude must be between -90 and 90."
msgstr "La latitud tiene que estar entre -90 y 90."

#: forms.py:31
msgid "The longitude must be between -180 and 180."
msgstr "La longitud tiene que estar entre -180 y 180."

#: image_forms.py:19
msgid "The file is not a valid SVG image."
msgstr "El archivo no es una imagen SVG válida."

