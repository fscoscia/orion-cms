msgid "Text"
msgstr "Texto"

#: blocks/content.py:161
msgid "Button style"
msgstr "Estilo del botón"

#: blocks/content.py:162
msgid "Primary"
msgstr "Principal"

#: blocks/content.py:162
msgid "Secondary"
msgstr "Secundario"

#: blocks/content.py:168
msgid "Button"
msgstr "Botón"

#: blocks/content.py:174 blocks/content.py:545
msgid "Buttons"
msgstr "Botones"

#: blocks/content.py:185
msgid "Supporting text"
msgstr "Texto de apoyo"

#: blocks/content.py:188 blocks/content.py:228 blocks/content.py:233
#: blocks/content.py:239 blocks/content.py:244 blocks/content.py:265
#: blocks/content.py:283
msgid "Image"
msgstr "Imagen"

#: blocks/content.py:190
msgid "Shown behind the text. Use a wide photo."
msgstr "Se muestra detrás del texto. Usar una foto apaisada."

#: blocks/content.py:195
msgid "Hero"
msgstr "Hero"

#: blocks/content.py:197
msgid ""
"The large opening section of a page, with a title, a short text, buttons and "
"an optional image."
msgstr ""
"La sección grande del comienzo de una página, con título, un texto corto, "
"botones y una imagen opcional."

#: blocks/content.py:216
msgid "Paragraphs with bold, italics, links, lists and subtitles."
msgstr "Párrafos con negrita, itálica, enlaces, listas y subtítulos."

#: blocks/content.py:229 blocks/content.py:240
msgid "Caption"
msgstr "Epígrafe"

#: blocks/content.py:234
msgid "A photo with an optional caption."
msgstr "Una foto con epígrafe opcional."

#: blocks/content.py:252
msgid "Images"
msgstr "Imágenes"

#: blocks/content.py:257
msgid "Gallery"
msgstr "Galería"

#: blocks/content.py:258
msgid "A grid of photos with optional captions."
msgstr "Una grilla de fotos con epígrafes opcionales."

#: blocks/content.py:270
msgid "Image position"
msgstr "Lado de la imagen"

#: blocks/content.py:271 blocks/content.py:539
msgid "Left"
msgstr "Izquierda"

#: blocks/content.py:271 blocks/content.py:539
msgid "Right"
msgstr "Derecha"

#: blocks/content.py:277
msgid "Image and text"
msgstr "Imagen y texto"

#: blocks/content.py:278
msgid "A photo next to a title, a text and buttons."
msgstr "Una foto al lado de un título, un texto y botones."

#: blocks/content.py:287 blocks/links.py:157
msgid "Link"
msgstr "Enlace"

#: blocks/content.py:289
msgid "Optional. The text defaults to the page title."
msgstr "Opcional. Si no se escribe un texto, se usa el título de la página."

#: blocks/content.py:294
msgid "Card"
msgstr "Tarjeta"

#: blocks/content.py:302
msgid "Columns"
msgstr "Columnas"

#: blocks/content.py:306 blocks/content.py:310
msgid "Cards"
msgstr "Tarjetas"

#: blocks/content.py:312
msgid "A grid of cards, each with an optional image, a text and a link."
msgstr ""
"Una grilla de tarjetas, cada una con imagen opcional, un texto y un enlace."

#: blocks/content.py:327
msgid "Number"
msgstr "Número"

#: blocks/content.py:329
msgid "Before the number"
msgstr "Antes del número"

#: blocks/content.py:332
msgid "After the number"
msgstr "Después del número"

#: blocks/content.py:338
msgid "Figure"
msgstr "Cifra"

#: blocks/content.py:345 blocks/content.py:349
msgid "Figures"
msgstr "Cifras"

#: blocks/content.py:350
msgid "Large numbers that count up when they appear on screen."
msgstr "Números grandes que se cuentan al aparecer en pantalla."

#: blocks/content.py:370
msgid "Tab"
msgstr "Pestaña"

#: blocks/content.py:374 blocks/content.py:379
msgid "Question"
msgstr "Pregunta"

#: blocks/content.py:375
msgid "Answer"
msgstr "Respuesta"

#: blocks/content.py:393 blocks/content.py:401
msgid "Tabs"
msgstr "Pestañas"

#: blocks/content.py:402
msgid "Content split into tabs; only one tab is shown at a time."
msgstr "Contenido dividido en pestañas; se muestra una pestaña a la vez."

#: blocks/content.py:416
msgid "Questions"
msgstr "Preguntas"

#: blocks/content.py:420
msgid "Accordion"
msgstr "Acordeón"

#: blocks/content.py:421
msgid "Questions that open to show their answer, such as an FAQ."
msgstr ""
"Preguntas que se abren para mostrar su respuesta, como unas preguntas "
"frecuentes."

#: blocks/content.py:441
msgid "Call to action"
msgstr "Llamada a la acción"

#: blocks/content.py:443
msgid "A highlighted box that invites visitors to take the next step."
msgstr "Un recuadro destacado que invita a dar el siguiente paso."

#: blocks/content.py:454 blocks/content.py:464
msgid "Logo"
msgstr "Logo"

#: blocks/content.py:456 blocks/content.py:613
msgid "Name"
msgstr "Nombre"

#: blocks/content.py:458
msgid "Read by screen readers and shown if the image fails to load."
msgstr "Lo leen los lectores de pantalla y se muestra si la imagen no carga."

#: blocks/content.py:460
msgid "Website"
msgstr "Sitio web"

#: blocks/content.py:471 blocks/content.py:475
msgid "Logos"
msgstr "Logos"

#: blocks/content.py:477
msgid "A row of logos, such as partners or clients, with optional links."
msgstr "Una fila de logos, como convenios o clientes, con enlaces opcionales."

#: blocks/content.py:484
msgid "Label"
msgstr "Etiqueta"

#: blocks/content.py:484
msgid "Opening hours"
msgstr "Horario"

#: blocks/content.py:490
msgid "Extra item"
msgstr "Dato extra"

#: blocks/content.py:497 blocks/links.py:105
#: templates/orion/includes/contact_details.html:8
msgid "Phone"
msgstr "Teléfono"

#: blocks/content.py:499
msgid "WhatsApp"
msgstr "WhatsApp"

#: blocks/content.py:501 blocks/links.py:104
#: templates/orion/includes/contact_details.html:8
msgid "Email"
msgstr "Email"

#: blocks/content.py:502 templates/orion/includes/contact_details.html:8
msgid "Address"
msgstr "Dirección"

#: blocks/content.py:504
msgid "Extra items"
msgstr "Datos extra"

#: blocks/content.py:519
msgid "Contact details"
msgstr "Datos de contacto"

#: blocks/content.py:521
msgid ""
"The site's phone, WhatsApp, email and address from Site data, plus extra "
"items such as opening hours."
msgstr ""
"El teléfono, el WhatsApp, el email y la dirección de Datos del sitio, más "
"datos extra como el horario."

#: blocks/content.py:538
msgid "Alignment"
msgstr "Alineación"

#: blocks/content.py:539
msgid "Center"
msgstr "Centro"

#: blocks/content.py:546
msgid "One to three buttons in a row."
msgstr "De uno a tres botones en fila."

#: blocks/content.py:565
msgid "How many"
msgstr "Cantidad"

#: blocks/content.py:569
msgid "Listing"
msgstr "Listado"

#: blocks/content.py:571
msgid "Optional. Without a listing, shows articles from all of them."
msgstr "Opcional. Sin un listado, muestra artículos de todos."

#: blocks/content.py:591
msgid "Latest articles"
msgstr "Últimas novedades"

#: blocks/content.py:592
msgid "The most recent articles, from every listing or from one."
msgstr "Los artículos más recientes, de todos los listados o de uno."

#: blocks/content.py:612
msgid "Location"
msgstr "Ubicación"

#: blocks/content.py:615
msgid "Description"
msgstr "Descripción"

#: blocks/content.py:618
msgid "For example, the address or the opening hours."
msgstr "Por ejemplo, la dirección o el horario."

#: blocks/content.py:623
msgid "Point"
msgstr "Punto"

#: blocks/content.py:631
msgid "Include the site location"
msgstr "Incluir la ubicación del sitio"

#: blocks/content.py:634
msgid "The location set in Site data."
msgstr "La ubicación cargada en Datos del sitio."

#: blocks/content.py:636
msgid "Points"
msgstr "Puntos"

#: blocks/content.py:638
msgid "Zoom"
msgstr "Zoom"

#: blocks/content.py:642
msgid "Used with a single point; several points are all shown."
msgstr "Se usa con un solo punto; con varios, se muestran todos."

#: blocks/content.py:676 templates/orion/includes/map.html:11
msgid "Map"
msgstr "Mapa"

#: blocks/content.py:678
msgid ""
"A map with the site location and other points, loaded when the visitor asks "
"for it."
msgstr "Un mapa con la ubicación del sitio y otros puntos, que se carga cuando el visitante lo pide."

#: blocks/content.py:722
msgid "The hero must be the first block."
msgstr "El Hero tiene que ser el primer bloque."

#: blocks/links.py:100
msgid "Leave empty to use the page title, email or phone."
msgstr "Dejar vacío para usar el título de la página, el email o el teléfono."

#: blocks/links.py:102
msgid "Page"
msgstr "Página"

#: blocks/links.py:103
msgid "External URL"
msgstr "URL externa"

#: blocks/links.py:107
msgid "Open in a new tab"
msgstr "Abrir en una pestaña nueva"

#: blocks/links.py:109
msgid "Only applies to external URLs."
msgstr "Solo se aplica a URLs externas."

#: blocks/links.py:126
msgid "Choose only one destination: a page, a URL, an email or a phone."
msgstr "Elegir un solo destino: una página, una URL, un email o un teléfono."

#: blocks/links.py:136
msgid "Choose a destination: a page, a URL, an email or a phone."
msgstr "Elegir un destino: una página, una URL, un email o un teléfono."

#: blocks/links.py:145
msgid "This address belongs to this site. Choose the page instead."
msgstr "Esta dirección es de este sitio. Conviene elegir la página."

#: blocks/links.py:149
msgid "Enter a phone number using digits, spaces, '+', '-' or parentheses."
msgstr "Ingresar un teléfono con dígitos, espacios, '+', '-' o paréntesis."

#: forms.py:26
msgid "Choose a location on the map."
msgstr "Elegir una ubicación en el mapa."

#: forms.py:29
msgid "The latitude must be between -90 and 90."
msgstr "La latitud tiene que estar entre -90 y 90."

#: forms.py:31
msgid "The longitude must be between -180 and 180."
msgstr "La longitud tiene que estar entre -180 y 180."

#: templates/orion/base.html:18
msgid "Skip to content"
msgstr "Saltar al contenido"

#: templates/orion/blocks/latest_articles.html:11
msgid "See all articles"
msgstr "Ver todas las novedades"

#: templates/orion/includes/footer.html:25
msgid "Social networks"
msgstr "Redes sociales"

#: templates/orion/includes/header.html:11
msgid "Home"
msgstr "Inicio"

#: templates/orion/includes/header.html:19
msgid "Menu"
msgstr "Menú"

#: templates/orion/includes/map.html:25
msgid "Show map"
msgstr "Ver mapa"

#: templates/orion/includes/map.html:26
msgid "Open in OpenStreetMap"
msgstr "Abrir en OpenStreetMap"

#: templates/orion/widgets/location_widget.html:11
msgid "Click on the map or drag the marker. You can also type the coordinates."
msgstr "Hacer clic en el mapa o arrastrar el marcador. También se pueden escribir las coordenadas."

#: templates/orion/widgets/location_widget.html:13
msgid "Latitude"
msgstr "Latitud"

#: templates/orion/widgets/location_widget.html:16
