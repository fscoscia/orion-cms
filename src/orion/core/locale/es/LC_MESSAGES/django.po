msgid "Text"
msgstr "Texto"

#: blocks/content.py:208
msgid "Button style"
msgstr "Estilo del botón"

#: blocks/content.py:209
msgid "Primary"
msgstr "Principal"

#: blocks/content.py:209
msgid "Secondary"
msgstr "Secundario"

#: blocks/content.py:215
msgid "Button"
msgstr "Botón"

#: blocks/content.py:221 blocks/content.py:637
msgid "Buttons"
msgstr "Botones"

#: blocks/content.py:232
msgid "Supporting text"
msgstr "Texto de apoyo"

#: blocks/content.py:235 blocks/content.py:278 blocks/content.py:286
#: blocks/content.py:293 blocks/content.py:298 blocks/content.py:328
#: blocks/content.py:354
msgid "Image"
msgstr "Imagen"

#: blocks/content.py:237
msgid "Shown behind the text. Use a wide photo."
msgstr "Se muestra detrás del texto. Usar una foto apaisada."

#: blocks/content.py:245
msgid "Hero"
msgstr "Hero"

#: blocks/content.py:247
msgid ""
"The large opening section of a page, with a title, a short text, buttons and "
"an optional image."
msgstr ""
"La sección grande del comienzo de una página, con título, un texto corto, "
"botones y una imagen opcional."

#: blocks/content.py:266
msgid "Paragraphs with bold, italics, links, lists and subtitles."
msgstr "Párrafos con negrita, itálica, enlaces, listas y subtítulos."

#: blocks/content.py:279 blocks/content.py:294
msgid "Caption"
msgstr "Epígrafe"

#: blocks/content.py:287
msgid "A photo with an optional caption."
msgstr "Una foto con epígrafe opcional."

#: blocks/content.py:306
msgid "Images"
msgstr "Imágenes"

#: blocks/content.py:317
msgid "Gallery"
msgstr "Galería"

#: blocks/content.py:318
msgid "A grid of photos with optional captions."
msgstr "Una grilla de fotos con epígrafes opcionales."

#: blocks/content.py:333
msgid "Image position"
msgstr "Lado de la imagen"

#: blocks/content.py:334 blocks/content.py:631
msgid "Left"
msgstr "Izquierda"

#: blocks/content.py:334 blocks/content.py:631
msgid "Right"
msgstr "Derecha"

#: blocks/content.py:343
msgid "Image and text"
msgstr "Imagen y texto"

#: blocks/content.py:344
msgid "A photo next to a title, a text and buttons."
msgstr "Una foto al lado de un título, un texto y botones."

#: blocks/content.py:358 blocks/links.py:157
msgid "Link"
msgstr "Enlace"

#: blocks/content.py:360
msgid "Optional. The text defaults to the page title."
msgstr "Opcional. Si no se escribe un texto, se usa el título de la página."

#: blocks/content.py:365
msgid "Card"
msgstr "Tarjeta"

#: blocks/content.py:373
msgid "Columns"
msgstr "Columnas"

#: blocks/content.py:377 blocks/content.py:387
msgid "Cards"
msgstr "Tarjetas"

#: blocks/content.py:389
msgid "A grid of cards, each with an optional image, a text and a link."
msgstr ""
"Una grilla de tarjetas, cada una con imagen opcional, un texto y un enlace."

#: blocks/content.py:404
msgid "Number"
msgstr "Número"

#: blocks/content.py:406
msgid "Before the number"
msgstr "Antes del número"

#: blocks/content.py:409
msgid "After the number"
msgstr "Después del número"

#: blocks/content.py:415
msgid "Figure"
msgstr "Cifra"

#: blocks/content.py:422 blocks/content.py:426
msgid "Figures"
msgstr "Cifras"

#: blocks/content.py:427
msgid "Large numbers that count up when they appear on screen."
msgstr "Números grandes que se cuentan al aparecer en pantalla."

#: blocks/content.py:447
msgid "Tab"
msgstr "Pestaña"

#: blocks/content.py:451 blocks/content.py:456
msgid "Question"
msgstr "Pregunta"

#: blocks/content.py:452
msgid "Answer"
msgstr "Respuesta"

#: blocks/content.py:470 blocks/content.py:478
msgid "Tabs"
msgstr "Pestañas"

#: blocks/content.py:479
msgid "Content split into tabs; only one tab is shown at a time."
msgstr "Contenido dividido en pestañas; se muestra una pestaña a la vez."

#: blocks/content.py:493
msgid "Questions"
msgstr "Preguntas"

#: blocks/content.py:497
msgid "Accordion"
msgstr "Acordeón"

#: blocks/content.py:498
msgid "Questions that open to show their answer, such as an FAQ."
msgstr ""
"Preguntas que se abren para mostrar su respuesta, como unas preguntas "
"frecuentes."

#: blocks/content.py:518
msgid "Call to action"
msgstr "Llamada a la acción"

#: blocks/content.py:520
msgid "A highlighted box that invites visitors to take the next step."
msgstr "Un recuadro destacado que invita a dar el siguiente paso."

#: blocks/content.py:531 blocks/content.py:541
msgid "Logo"
msgstr "Logo"

#: blocks/content.py:533 blocks/content.py:783
msgid "Name"
msgstr "Nombre"

#: blocks/content.py:535
msgid "Read by screen readers and shown if the image fails to load."
msgstr "Lo leen los lectores de pantalla y se muestra si la imagen no carga."

#: blocks/content.py:537
msgid "Website"
msgstr "Sitio web"

#: blocks/content.py:548 blocks/content.py:558
msgid "Logos"
msgstr "Logos"

#: blocks/content.py:560
msgid "A row of logos, such as partners or clients, with optional links."
msgstr "Una fila de logos, como convenios o clientes, con enlaces opcionales."

#: blocks/content.py:576
msgid "Label"
msgstr "Etiqueta"

#: blocks/content.py:576
msgid "Opening hours"
msgstr "Horario"

#: blocks/content.py:582
msgid "Extra item"
msgstr "Dato extra"

#: blocks/content.py:589 blocks/links.py:105
#: templates/orion/includes/contact_details.html:8
msgid "Phone"
msgstr "Teléfono"

#: blocks/content.py:591
msgid "WhatsApp"
msgstr "WhatsApp"

#: blocks/content.py:593 blocks/links.py:104
#: templates/orion/includes/contact_details.html:8
msgid "Email"
msgstr "Email"

#: blocks/content.py:594 templates/orion/includes/contact_details.html:8
msgid "Address"
msgstr "Dirección"

#: blocks/content.py:596
msgid "Extra items"
msgstr "Datos extra"

#: blocks/content.py:611
msgid "Contact details"
msgstr "Datos de contacto"

#: blocks/content.py:613
msgid ""
"The site's phone, WhatsApp, email and address from Site data, plus extra "
"items such as opening hours."
msgstr ""
"El teléfono, el WhatsApp, el email y la dirección de Datos del sitio, más "
"datos extra como el horario."

#: blocks/content.py:630
msgid "Alignment"
msgstr "Alineación"

#: blocks/content.py:631
msgid "Center"
msgstr "Centro"

#: blocks/content.py:638
msgid "One to three buttons in a row."
msgstr "De uno a tres botones en fila."

#: blocks/content.py:674
msgid "How many"
msgstr "Cantidad"

#: blocks/content.py:678
msgid "Listing"
msgstr "Listado"

#: blocks/content.py:680
msgid "Optional. Without a listing, shows articles from all of them."
msgstr "Opcional. Sin un listado, muestra artículos de todos."

#: blocks/content.py:709
msgid "Latest articles"
msgstr "Últimas novedades"

#: blocks/content.py:710
msgid "The most recent articles, from every listing or from one."
msgstr "Los artículos más recientes, de todos los listados o de uno."

#: blocks/content.py:720 blocks/content.py:751
msgid "Form"
msgstr "Formulario"

#: blocks/content.py:721
msgid "Submissions arrive at the form's page, as if sent from there."
msgstr ""
"Los envíos llegan a la página del formulario, como si se enviaran desde ahí."

#: blocks/content.py:752
msgid "A form created in Pages, to fill in from this page."
msgstr "Un formulario creado en Páginas, para completarlo desde esta página."

#: blocks/content.py:782
msgid "Location"
msgstr "Ubicación"

#: blocks/content.py:785
msgid "Description"
msgstr "Descripción"

#: blocks/content.py:788
msgid "For example, the address or the opening hours."
msgstr "Por ejemplo, la dirección o el horario."

#: blocks/content.py:793
msgid "Point"
msgstr "Punto"

#: blocks/content.py:801
msgid "Include the site location"
msgstr "Incluir la ubicación del sitio"

#: blocks/content.py:804
msgid "The location set in Site data."
msgstr "La ubicación cargada en Datos del sitio."

#: blocks/content.py:806
msgid "Points"
msgstr "Puntos"

#: blocks/content.py:808
msgid "Zoom"
msgstr "Zoom"

#: blocks/content.py:812
msgid "Used with a single point; several points are all shown."
msgstr "Se usa con un solo punto; con varios, se muestran todos."

#: blocks/content.py:846 templates/orion/includes/map.html:11
msgid "Map"
msgstr "Mapa"

#: blocks/content.py:848
msgid ""
"A map with the site location and other points, loaded when the visitor asks "
"for it."
msgstr ""
"Un mapa con la ubicación del sitio y otros puntos, que se carga cuando el "
"visitante lo pide."

#: blocks/content.py:893
msgid "The hero must be the first block."
msgstr "El Hero tiene que ser el primer bloque."

#: blocks/links.py:100
msgid "Leave empty to use the page title, email or phone."
msgstr "Dejar vacío para usar el título de la página, el email o el teléfono."

#: blocks/links.py:102
msgid "Page"
msgstr "Página"

#: blocks/links.py:103
msgid "External URL"
msgstr "URL externa"

#: blocks/links.py:107
msgid "Open in a new tab"
msgstr "Abrir en una pestaña nueva"

#: blocks/links.py:109
msgid "Only applies to external URLs."
msgstr "Solo se aplica a URLs externas."

#: blocks/links.py:126
msgid "Choose only one destination: a page, a URL, an email or a phone."
msgstr "Elegir un solo destino: una página, una URL, un email o un teléfono."

#: blocks/links.py:136
msgid "Choose a destination: a page, a URL, an email or a phone."
msgstr "Elegir un destino: una página, una URL, un email o un teléfono."

#: blocks/links.py:145
msgid "This address belongs to this site. Choose the page instead."
msgstr "Esta dirección es de este sitio. Conviene elegir la página."

#: blocks/links.py:149
msgid "Enter a phone number using digits, spaces, '+', '-' or parentheses."
msgstr "Ingresar un teléfono con dígitos, espacios, '+', '-' o paréntesis."

#: document_forms.py:25
#, python-format
msgid "The file is too large. The maximum is %(size)s."
msgstr "El archivo es demasiado grande. El máximo es %(size)s."

#: document_forms.py:32
#, python-format
msgid "The file's content does not match its type (%(extension)s)."
msgstr "El contenido del archivo no corresponde a su tipo (%(extension)s)."

#: forms.py:26
msgid "Choose a location on the map."
msgstr "Elegir una ubicación en el mapa."

#: forms.py:29
msgid "The latitude must be between -90 and 90."
msgstr "La latitud tiene que estar entre -90 y 90."

#: forms.py:31
msgid "The longitude must be between -180 and 180."
msgstr "La longitud tiene que estar entre -180 y 180."

#: image_forms.py:19
msgid "The file is not a valid SVG image."
msgstr "El archivo no es una imagen SVG válida."

#: templates/orion/base.html:23
msgid "Skip to content"
msgstr "Saltar al contenido"

