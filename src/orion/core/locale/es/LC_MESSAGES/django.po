#: blocks/content.py:138 blocks/content.py:284 blocks/content.py:363
msgid "Title"
msgstr "Título"

#: blocks/content.py:139
msgid "Make words bold to highlight them."
msgstr "Poner en negrita las palabras que se quieren resaltar."

#: blocks/content.py:145
msgid "A title must be a single paragraph."
msgstr "Un título tiene que ser un solo párrafo."

