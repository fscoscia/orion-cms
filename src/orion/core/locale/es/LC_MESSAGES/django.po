msgstr "Desactivar para ocultar el bloque sin borrarlo."

#: blocks/content.py:185 blocks/content.py:355 blocks/content.py:440
msgid "Title"
msgstr "Título"

#: blocks/content.py:186
msgid "Make words bold to highlight them."
msgstr "Poner en negrita las palabras que se quieren resaltar."

#: blocks/content.py:192
msgid "A title must be a single paragraph."
msgstr "Un título tiene que ser un solo párrafo."

#: blocks/content.py:200 blocks/content.py:265 blocks/content.py:356
#: blocks/content.py:411 blocks/content.py:513 blocks/content.py:578
