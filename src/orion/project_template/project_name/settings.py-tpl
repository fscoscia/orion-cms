"""Settings for {{ project_name }}, built on Orion.

Everything that differs between environments, or that is secret, is read from
environment variables; see ``.env.example`` for the full list.
"""

from pathlib import Path

from orion.settings.env import load_env_file

BASE_DIR = Path(__file__).resolve().parent.parent

# Before Orion's settings, which read the environment when imported. Variables already
# set in the environment win over the file.
load_env_file(BASE_DIR / ".env")

from orion.settings.base import *  # noqa: E402, F403

ROOT_URLCONF = "{{ project_name }}.urls"
WSGI_APPLICATION = "{{ project_name }}.wsgi.application"

STATIC_ROOT = BASE_DIR / "static"
MEDIA_ROOT = BASE_DIR / "media"

INSTALLED_APPS += ["home"]

# Templates that replace Orion's by name (header, footer, blocks) go here.
TEMPLATES[0]["DIRS"] = [BASE_DIR / "templates"]

# Compiling this project's own stylesheet (`pipenv run css-build`), separate from the
# one Orion already ships. See static_src/project.css and templates/orion/base.html.
INSTALLED_APPS += ["django_tailwind_cli"]
STATICFILES_DIRS = [BASE_DIR / "assets"]
TAILWIND_CLI_VERSION = "4.3.3"
TAILWIND_CLI_SRC_CSS = BASE_DIR / "static_src" / "project.css"
TAILWIND_CLI_DIST_CSS = "project/css/project.css"
TAILWIND_CLI_PATH = BASE_DIR / ".tailwind"
