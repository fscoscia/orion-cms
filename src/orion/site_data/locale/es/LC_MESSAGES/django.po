#: apps.py:8
msgid "Site data"
msgstr "Datos del sitio"

#: models.py:31
msgid "Network"
msgstr "Red"

#: models.py:32
msgid "Profile URL"
msgstr "URL del perfil"

#: models.py:36
msgid "Social network"
msgstr "Red social"

#: models.py:45
msgid "logo"
msgstr "logo"

#: models.py:50
msgid "Without a logo, the header shows the site name."
msgstr "Sin logo, el encabezado muestra el nombre del sitio."

#: models.py:54
msgid "footer logo"
msgstr "logo del pie"

#: models.py:59
msgid "Usually a light version for the dark footer."
msgstr "Normalmente una versión clara para el pie oscuro."

#: models.py:63
msgid "privacy policy page"
msgstr "página de política de privacidad"

#: models.py:68
msgid "Linked from the consent checkbox of every form."
msgstr ""
"Se enlaza desde la casilla de consentimiento de todos los formularios."

#: models.py:70
msgid "phone"
msgstr "teléfono"

#: models.py:71
msgid "WhatsApp"
msgstr "WhatsApp"

#: models.py:72
msgid "email"
msgstr "email"

#: models.py:73
msgid "address"
msgstr "dirección"

#: models.py:75
msgid "location on the map"
msgstr "ubicación en el mapa"

#: models.py:78
msgid "Shown on the contact page and in map blocks."
msgstr "Se muestra en la página de contacto y en los bloques de mapa."

#: models.py:81
msgid "map zoom"
msgstr "zoom del mapa"

#: models.py:84
msgid "From 1 (the whole world) to 19 (a single building)."
msgstr "De 1 (el mundo entero) a 19 (un edificio)."

#: models.py:89
msgid "social networks"
msgstr "redes sociales"

#: models.py:93
msgid "favicon"
msgstr "favicon"

#: models.py:98
msgid "The browser tab icon. A square image of at least 512 × 512 px."
msgstr ""
"El ícono de la pestaña del navegador. Una imagen cuadrada de al menos 512 × "
"512 px."

#: models.py:102
msgid "default social image"
msgstr "imagen para redes por defecto"

#: models.py:108
msgid ""
"Shown when a page without its own image is shared. 1200 × 630 px works best."
msgstr ""
"Se muestra al compartir una página sin imagen propia. Lo ideal es 1200 × 630"
" px."

#: models.py:113
msgid "robots.txt"
msgstr "robots.txt"

#: models.py:116
msgid ""
"Leave empty to let search engines read the whole site except the admin. The "
"sitemap line is added automatically."
msgstr ""
"Dejar vacío para que los buscadores lean todo el sitio salvo el admin. La "
"línea del sitemap se agrega sola."

#: models.py:121
msgid "Google Search Console verification code"
msgstr "código de verificación de Google Search Console"

#: models.py:128
msgid "Paste only the code: the value of content=\"...\" in the verification tag."
msgstr ""
"Pegar solo el código: el valor de content=\"...\" de la etiqueta de "
"verificación."

#: models.py:143
msgid "Identity"
msgstr "Identidad"

#: models.py:154
msgid "Contact"
msgstr "Contacto"

#: models.py:156
msgid "Social networks"
msgstr "Redes sociales"

#: models.py:164
msgid "SEO"
msgstr "SEO"

#: models.py:170
msgid "site data"
msgstr "datos del sitio"

#: models.py:194
msgid "tagline"
msgstr "eslogan"

#: models.py:196
msgid "site description"
msgstr "descripción del sitio"

#: models.py:199
msgid "Shown by search engines for pages without their own description."
msgstr "La muestran los buscadores en las páginas sin descripción propia."

#: models.py:202
msgid "legal text"
msgstr "texto legal"

#: models.py:204
msgid "Shown at the bottom of the footer, for example the copyright."
msgstr "Se muestra al final del pie, por ejemplo el copyright."

#: models.py:214 models.py:215
msgid "site texts"
msgstr "textos del sitio"

#: models.py:221
msgid "This language already has its site texts. Edit the existing ones."
msgstr "Este idioma ya tiene sus textos del sitio. Editar los existentes."

#: models.py:227
#, python-brace-format
msgid "Site texts ({language})"
msgstr "Textos del sitio ({language})"
