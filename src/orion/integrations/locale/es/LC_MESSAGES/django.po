#: templates/orion/integrations/email_warning.html:7
msgid ""
"The site's emails are not going out: no mail server is configured. Form "
"submissions stay in their inbox without an email notice."
msgstr ""
"Los emails del sitio no están saliendo: no hay un servidor de email "
"configurado. Los envíos de formularios quedan en su bandeja sin aviso por "
"email."

#: templates/orion/integrations/email_warning.html:9
msgid "The site's emails are not going out: the last delivery failed."
msgstr "Los emails del sitio no están saliendo: el último envío falló."

#: templates/orion/integrations/email_warning.html:12
