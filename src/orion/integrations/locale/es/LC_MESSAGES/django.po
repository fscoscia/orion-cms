#: templates/orion/integrations/integrations.html:24
msgid ""
"No mail server is configured: in development, emails are written to the "
"console."
msgstr ""
"No hay un servidor de email configurado: en desarrollo, los emails se "
"escriben en la consola."

#: templates/orion/integrations/integrations.html:26
msgid ""
"No mail server is configured: emails are discarded. Form submissions stay in "
"their inbox without an email notice."
msgstr ""
"No hay un servidor de email configurado: los emails se descartan. Los envíos "
"de formularios quedan en su bandeja sin aviso por email."

