#, python-format
msgid "Test email from %(site)s"
msgstr "Email de prueba de %(site)s"

#: views.py:37
msgid ""
"This is a test from the site's Integrations screen. If you read it, the "
"site's emails go out."
msgstr ""
"Esta es una prueba desde la pantalla Integraciones del sitio. Si llegó, los "
"emails del sitio salen."

#: views.py:47
#, python-format
msgid "The test email could not be sent: %(error)s"
msgstr "No se pudo mandar el email de prueba: %(error)s"

#: views.py:52
